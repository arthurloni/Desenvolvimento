      "locked": false,
      "text": "Os logs e um tipo de crescimento, que consegue ser muito mais eficiente em determinadas situações.",
      "fontSize": 31.225579710594626,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Os logs e um tipo de crescimento, que consegue ser muito mais eficiente em determinadas situações.",
