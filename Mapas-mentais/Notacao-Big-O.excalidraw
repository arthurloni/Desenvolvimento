      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 2014545004,
      "version": 976,
      "versionNonce": 2054741484,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "fHGMGXJe47HCnuPE58WYs",
          "type": "arrow"
        }
      ],
      "updated": 1789098010841,
      "created": 1789094935142,
      "link": null,
      "locked": false,
      "text": "Escalabilidade:\nÉ a capacidade de um sistema,\nnegócio ou tecnologia \ncrescer e lidar com uma demanda maior de trabalho\nsem perder o desempenho \nou aumentar os custos na mesma proporção.",
      "fontSize": 31.225579710594626,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Escalabilidade:\nÉ a capacidade de um sistema,\nnegócio ou tecnologia \ncrescer e lidar com uma demanda maior de trabalho\nsem perder o desempenho \nou aumentar os custos na mesma proporção.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
