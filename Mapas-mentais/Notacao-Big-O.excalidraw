      "version": 1419,
      "versionNonce": 591002348,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789098010841,
      "created": 1789096574245,
      "link": null,
      "locked": false,
      "text": "Se a lista tem 10 itens, o loop roda 10 vezes. \nSe tem 1 milhão, roda 1 milhão de vezes. \nO trabalho cresce na mesma proporção que o tamanho da entrada. Isso é O(n).\n",
      "fontSize": 31.225579710594626,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se a lista tem 10 itens, o loop roda 10 vezes. \nSe tem 1 milhão, roda 1 milhão de vezes. \nO trabalho cresce na mesma proporção que o tamanho da entrada. Isso é O(n).\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
