      "type": "text",
      "x": -2394.499221274477,
      "y": 2341.2585253561874,
      "width": 1104.04204151472,
      "height": 156.12789855297314,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
