    {
      "id": "ZHvZxixGhgwd4VpEivfGT",
      "type": "text",
      "x": -2463.045334449992,
      "y": -755.1716367884736,
      "width": 534.7796020507812,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IUiptg6aZkoUl8czx3G7I"
      ],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 697898695,
      "version": 1902,
      "versionNonce": 1555425193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787886519692,
      "link": null,
      "locked": false,
      "text": "Conceitos:\nHandShake = Negociação entre o cliente e o servidor\n(Quais regras vão utilizar)\nAutenticação: Garantir que o site e ele mesmo\nIntegridade: Garantir que ninguem manipulou os dados\nentre uma requisição e resposta\nDominio: Forma de nomear e mascarar seu IP, com nome\nDns: Sistema de nomes de dominios, ele serve para\nfacilitar o acesso ao site, buscando o IP do dominio\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conceitos:\nHandShake = Negociação entre o cliente e o servidor\n(Quais regras vão utilizar)\nAutenticação: Garantir que o site e ele mesmo\nIntegridade: Garantir que ninguem manipulou os dados\nentre uma requisição e resposta\nDominio: Forma de nomear e mascarar seu IP, com nome\nDns: Sistema de nomes de dominios, ele serve para\nfacilitar o acesso ao site, buscando o IP do dominio\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GmuF7OXad11nUeAxwszu3",
      "type": "rectangle",
      "x": -2483.116763021421,
      "y": -516.0287796456162,
      "width": 700,
      "height": 217.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
