    },
    {
      "id": "YCwFUwvoOuGvKUedY3SyX",
      "type": "rectangle",
      "x": -3124.456587464965,
      "y": -53.75303067746643,
      "width": 918.3333333333333,
      "height": 247.91666666666669,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
