      "text": "API (InterFace de programação de Aplicativos)\n",
      "fontSize": 23.333333333333318,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API (InterFace de programação de Aplicativos)\n",
